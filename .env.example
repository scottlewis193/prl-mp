# PocketBase API used by both the browser and the SvelteKit server.
PUBLIC_PB_URL=http://127.0.0.1:8090

# Optional service account used by the background race simulator.
# Leave both blank to run only the web application.
PB_USER=
PB_PASS=

# Optional PocketBase dashboard account, created by the initial migration.
PB_SUPERUSER_EMAIL=
PB_SUPERUSER_PASS=

# Set to true when developing without user authentication.
DISABLE_AUTH=false

# Optional web-push configuration.
PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
